<p class="seccion"><%= seccion %></p>
<h1>Nueva reserva</h1>

<% if (errores.length > 0) { %>
  <div class="errores" role="alert">
    <p>Revisá los siguientes datos:</p>
    <ul>
      <% errores.forEach(function(error) { %>
        <li><%= error %></li>
      <% }); %>
    </ul>
  </div>
<% } %>

<form action="/reservas" method="post" class="formulario">
  <div class="campo">
    <label for="estudiante">Estudiante</label>
    <input type="text" id="estudiante" name="estudiante" required value="<%= valores.estudiante || '' %>">
  </div>

  <div class="campo">
    <label for="email">Email</label>
    <input type="email" id="email" name="email" required value="<%= valores.email || '' %>">
  </div>

  <div class="campo">
    <label for="sala">Sala</label>
    <select id="sala" name="sala" required>
      <option value="">Elegí una sala</option>
      <% salas.forEach(function(sala) { %>
        <option value="<%= sala %>" <%= valores.sala === sala ? "selected" : "" %>><%= sala %></option>
      <% }); %>
    </select>
  </div>

  <div class="campo">
    <label for="fecha">Fecha</label>
    <input type="date" id="fecha" name="fecha" required value="<%= valores.fecha || '' %>">
  </div>

  <div class="campo">
    <label for="turno">Turno</label>
    <select id="turno" name="turno" required>
      <option value="">Elegí un turno</option>
      <% turnos.forEach(function(turno) { %>
        <option value="<%= turno %>" <%= valores.turno === turno ? "selected" : "" %>><%= turno %></option>
      <% }); %>
    </select>
  </div>

  <div class="campo">
    <label for="personas">Personas</label>
    <input type="number" id="personas" name="personas" min="1" max="6" step="1" required value="<%= valores.personas !== undefined ? valores.personas : '' %>">
  </div>

  <button type="submit" class="boton">Reservar</button>
</form>
